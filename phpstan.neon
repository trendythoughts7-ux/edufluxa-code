includes:
    - vendor/larastan/larastan/extension.neon
parameters:
    level: 2
    ignoreErrors:
        - '#^Cannot cast Illuminate\\Contracts\\View\\View to string\.$#'
        - '#^Function _il_exec not found\.$#'
    paths:
        - app
    excludePaths:
        - app/Http/Controllers/Api/Instructor/*
    bootstrapFiles:
        - vendor/autoload.php
