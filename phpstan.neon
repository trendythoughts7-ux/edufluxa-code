includes:
    - vendor/larastan/larastan/extension.neon
parameters:
    parallel:
        maximumNumberOfProcesses: 2
    level: 2
    ignoreErrors:
        - '#^Cannot cast Illuminate\\Contracts\\View\\View to string\.$#'
        - '#^Function _il_exec not found\.$#'
        -
            message: '#^Call to an undefined method Omnipay\\Common\\(GatewayInterface|Message\\ResponseInterface|Message\\NotificationInterface)::#'
            paths:
                - app/PaymentChannels/Drivers/Braintree/Channel.php
                - app/PaymentChannels/Drivers/Mollie/Channel.php
                - app/PaymentChannels/Drivers/Robokassa/Channel.php
                - app/PaymentChannels/Drivers/Paysera/Channel.php
        -
            message: '#^Call to an undefined method net\\authorize\\api\\contract\\v1\\ANetApiResponseType::getTransactionResponse\(\)\.$#'
            path: app/PaymentChannels/Drivers/Authorizenet/Channel.php
        -
            message: '#^Variable \$response in empty\(\) always exists and is not falsy\.$#'
            path: app/PaymentChannels/Drivers/Authorizenet/Channel.php
        -
            message: '#^Variable \$verifyTransaction in empty\(\) always exists and is not falsy\.$#'
            path: app/PaymentChannels/Drivers/Chapa/Channel.php
        -
            message: '#^Access to an undefined property WebToPay_PaymentMethod::\$(minAmount|maxAmount|currency)\.$#'
            path: app/PaymentChannels/Drivers/Paysera/WebToPay.php
        -
            message: '#^PHPDoc tag @param has invalid value#'
            path: app/PaymentChannels/Drivers/Paysera/WebToPay.php
        -
            message: '#^Function get_magic_quotes_gpc not found\.$#'
            path: app/PaymentChannels/Drivers/Paysera/WebToPay.php
        -
            message: '#^Access to an undefined property Laravel\\Socialite\\Contracts\\User::\$(id|email|name)\.$#'
            path: app/Http/Controllers/Auth/SocialiteController.php
        -
            message: '#^Call to an undefined method object\{quantity: int, product: mixed\}::update\(\)\.$#'
            path: app/Http/Controllers/Web/CartManagerController.php
        -
            message: '#^Call to an undefined static method SebaCarrasco93\\LaravelPayku\\Facades\\LaravelPayku::create\(\)\.$#'
            path: app/PaymentChannels/Drivers/Payku/Channel.php
        -
            message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Collection\<int, SebaCarrasco93\\LaravelPayku\\Models\\PaykuTransaction\>\|SebaCarrasco93\\LaravelPayku\\Models\\PaykuTransaction::\$status\.$#'
            path: app/PaymentChannels/Drivers/Payku/Channel.php
        -
            message: '#^Access to an undefined property Razorpay\\Api\\Api::\$payment\.$#'
            path: app/PaymentChannels/Drivers/Razorpay/Channel.php
        -
            message: '#^Access to an undefined property Unicodeveloper\\Paystack\\Paystack::\$url\.$#'
            path: app/PaymentChannels/Drivers/Paystack/Channel.php
        -
            # Jorenvh\Share\ShareFacade uses @method page(...) docblock magic (standard Laravel
            # facade pattern) which Larastan cannot resolve for this package, flagging it as a
            # static-call-to-instance-method. Verified vendor source: Share::page() exists and
            # works correctly at runtime via the facade accessor.
            message: '#^Static call to instance method Jorenvh\\Share\\ShareFacade::page\(\)\.$#'
            paths:
                - app/Models/Blog.php
                - app/Models/Bundle.php
                - app/Models/Event.php
                - app/Models/Product.php
                - app/Models/UpcomingCourse.php
                - app/Models/Webinar.php
        -
            # torann/geoip GeoIP::getLocation() has a non-nullable @return \Torann\GeoIP\Location
            # docblock (throws Exception on hard failure), so Larastan treats the result as
            # always-truthy. In practice this wraps an external IP-geolocation lookup whose fields
            # (e.g. iso_code) can legitimately be empty on partial/degraded lookups. Same defensive-
            # check treatment as the Authorizenet/Chapa external-API guards confirmed in Phase 1.
            message: '#^Variable \$location in empty\(\) always exists and is not falsy\.$#'
            paths:
                - app/Http/Middleware/Api/CheckRestrictionAPI.php
                - app/Http/Middleware/CheckRestriction.php
                - app/Http/Middleware/UserLocale.php
        -
            # Group 2: variables from Eloquent ::create() (throws on failure, never returns null/false)
            # or from Eloquent relation/query ->get() results (Collection object, never null even when
            # empty) or foreach loop variables (guaranteed non-null per iteration). Larastan flags these
            # empty() guards as always-true since the return/loop type is non-nullable. Verified each
            # variable's origin individually before adding - see Master Resume Prompt Group 2 for detail.
            message: '#^Variable \$(assignment|chapter|faq|file|quizQuestion|questionAnswer|session|ticket|selectedSpecification|upcomingCourse|webinarExtraDescription|quiz|meetingTimes|meetingsTimes|hasMeetings|userMetas|prerequisites|installmentOrder) in empty\(\) always exists and is not falsy\.$#'
            paths:
                - app/Http/Controllers/Panel/AssignmentController.php
                - app/Http/Controllers/Panel/ChapterController.php
                - app/Http/Controllers/Panel/FAQController.php
                - app/Http/Controllers/Panel/FileController.php
                - app/Http/Controllers/Panel/QuizQuestionController.php
                - app/Http/Controllers/Panel/SessionController.php
                - app/Http/Controllers/Panel/TicketController.php
                - app/Http/Controllers/Panel/Store/ProductFaqController.php
                - app/Http/Controllers/Panel/Store/ProductFileController.php
                - app/Http/Controllers/Panel/Store/ProductSpecificationController.php
                - app/Http/Controllers/Panel/UpcomingCoursesController.php
                - app/Http/Controllers/Panel/WebinarExtraDescriptionController.php
                - app/Services/App/QuizManagementService.php
                - app/Http/Controllers/Panel/MeetingController.php
                - app/Http/Controllers/Web/InstructorFinderController.php
                - app/Http/Controllers/Web/InstructorsController.php
                - app/Http/Controllers/Web/UserProfileController.php
                - app/Models/Api/Traits/CheckForSaleTrait.php
                - app/Models/Bundle.php
                - app/Models/Webinar.php
        -
            # Group 3: $activePackage from UserPackage::getPackage(), which has a non-nullable
            # `: UserPackage` return-type declaration - every code path (make()/getDefaultPackage())
            # returns a valid instance, never null. Larastan correctly flags the empty() guard as dead.
            # Verified full method body in app/Mixins/RegistrationPackage/UserPackage.php before adding.
            message: '#^Variable \$activePackage in empty\(\) always exists and is not falsy\.$#'
            paths:
                - app/Http/Controllers/Panel/EventsCalendarController.php
        -
            # Group 4a: Bigbluebutton facade static calls (initCreateMeeting/create/join) - all three
            # have @method static docblocks on JoisarJignesh\Bigbluebutton\Facades\Bigbluebutton and
            # a genuine instance method on the underlying Bbb/InitMeeting trait classes (verified in
            # vendor source). Larastan mis-resolves the facade's instance-vs-static binding, same class
            # of false-positive as the already-closed Jorenvh\Share\ShareFacade::page() rule.
            message: '#^Static call to instance method JoisarJignesh\\Bigbluebutton\\Facades\\Bigbluebutton::(initCreateMeeting|create|join)\(\)\.$#'
            paths:
                - app/Http/Controllers/Admin/SessionController.php
                - app/Http/Controllers/Panel/SessionController.php
        -
            # Group 4b: $createMeeting->setDuration() - $createMeeting is the return value of
            # initCreateMeeting(), whose vendor docblock declares @return CreateMeetingParameters
            # (BigBlueButton\Parameters\CreateMeetingParameters). setDuration() genuinely exists on
            # that class (verified - it's called on the same object inside initCreateMeeting() itself).
            # Larastan can't resolve initCreateMeeting()'s return type through the facade, so it treats
            # the chained call as undefined. Not a bug - verified against vendor source.
            message: '#^Call to an undefined method JoisarJignesh\\Bigbluebutton\\Facades\\Bigbluebutton::setDuration\(\)\.$#'
            paths:
                - app/Http/Controllers/Admin/SessionController.php
                - app/Http/Controllers/Panel/SessionController.php
        -
            # Confirmed ionCube-encrypted vendor classes (App\Services\*LicenseService, App\Models\PurchaseCode) -
            # phpstan cannot parse encrypted PHP, so it reports every reference to them as an unknown
            # class/type/constant. Verified identical pattern to ThemeBuilderLicenseController (already closed).
            message: '#.*#'
            paths:
                - app/Http/Controllers/Admin/MobileAppLicenseController.php
                - app/Http/Controllers/Admin/PluginLicenseController.php
                - app/Http/Controllers/Admin/ThemeBuilderLicenseController.php
        -
            # PurchaseCodeController.php itself is clean, uncompiled PHP - but its two
            # dependencies (App\Services\LicenseService, App\Models\PurchaseCode) are
            # ionCube-encrypted, so phpstan cannot reflect them and reports every reference
            # (constructor param type, static method calls, constant access) as an unknown
            # class. Verified at runtime via ReflectionClass: all 3 constants + 3 methods +
            # class itself genuinely exist and are callable. Narrow, class-scoped rule (not a
            # file-blanket fold like ThemeBuilderLicenseController) since the controller code
            # itself is real and should stay checkable.
            message: '#(unknown class App\\Services\\LicenseService|unknown class App\\Models\\PurchaseCode|invalid type App\\Services\\LicenseService)#'
            path: app/Http/Controllers/Web/PurchaseCodeController.php
            count: 11
        -
            # Group 5: $user (BecomeInstructorController::checkPackageHasInstallment) is
            # guaranteed non-null - route is wrapped in 'web.auth' middleware group
            # (routes/web.php, verified via brace-matching), which blocks unauthenticated
            # requests before the controller runs. $notifyOptions (CronJobsController) is
            # assigned unconditionally as a 3-key array literal directly above the guard,
            # with no branch that could produce an empty array. Both traced individually
            # per Rule K before adding.
            message: '#^Variable \$(user|notifyOptions) in empty\(\) always exists and is not falsy\.$#'
            paths:
                - app/Http/Controllers/Web/BecomeInstructorController.php
                - app/Http/Controllers/Web/CronJobsController.php
        -
            # Group 6: OrderItem::$user, $eventTicket, $meetingPackage are Eloquent BelongsTo
            # relation methods, not settable properties - Larastan correctly flags direct
            # assignment ($orderItem->user = $user) as "not writable" per Eloquent's normal
            # rules. However $orderItem here is used purely as an in-memory carrier: it is
            # never persisted (verified no ->save()/::create() call anywhere in this flow -
            # EventsController/MeetingPackagesController -> Sale::handleSaleNotifications ->
            # EventTicketSoldMixins::makeTicket / MeetingPackageSoldMixins::makeUserSessions),
            # so the "not writable" warning is cosmetic; the magic-attribute values are read
            # back directly by those downstream methods to avoid extra DB queries. Confirmed
            # the two real OrderItem::create() call sites elsewhere (CartCheckoutService,
            # WebCartCheckoutService) do not use these keys, so this suppression can't mask
            # a real mass-assignment issue there.
            message: '#^Property App\\Models\\OrderItem::\$(user|eventTicket|meetingPackage) is not writable\.$#'
            paths:
                - app/Http/Controllers/Web/EventsController.php
                - app/Http/Controllers/Web/MeetingPackagesController.php
    paths:
        - app
    excludePaths:
        - app/Providers/LicenseEventServiceProvider.php
        - app/Http/Controllers/Api/Instructor/*
    bootstrapFiles:
        - vendor/autoload.php
